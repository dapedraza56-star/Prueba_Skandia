# Copia este archivo como .env (Git lo ignora) y completa la clave. Nunca subas el .env.
#
# Opcion 1 - GitHub Models (gratis con tu cuenta de GitHub):
#   Crea un token "fine-grained" en https://github.com/settings/personal-access-tokens
#   con el permiso de cuenta "Models: Read" y pegalo abajo.
TRIAGE_PROVEEDOR=github
TRIAGE_ENDPOINT=https://models.github.ai/inference
TRIAGE_MODELO=openai/gpt-4.1-mini
TRIAGE_API_KEY=

# Opcion 2 - Azure OpenAI / AI Foundry (Reto 3):
# TRIAGE_PROVEEDOR=azure
# TRIAGE_ENDPOINT=https://<tu-recurso>.openai.azure.com/openai/v1
# TRIAGE_MODELO=<nombre-del-despliegue>
# TRIAGE_API_KEY=

TRIAGE_TIMEOUT_S=30
